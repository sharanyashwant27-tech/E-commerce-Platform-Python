# Application
APP_NAME=ShopSphere
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8908
BASE_URL=http://localhost:8908

# Database (SQLite for local dev; PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./shopsphere.db
# DATABASE_URL=postgresql+asyncpg://shopsphere:shopsphere@db:5432/shopsphere

# Sync DB URL for Alembic
DATABASE_URL_SYNC=sqlite:///./shopsphere.db
# DATABASE_URL_SYNC=postgresql://shopsphere:shopsphere@db:5432/shopsphere

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@shopsphere.local
SMTP_FROM_NAME=ShopSphere
SMTP_TLS=true

# Stripe (sandbox)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Razorpay (sandbox)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Payments
DEFAULT_PAYMENT_PROVIDER=stripe

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# CORS
CORS_ORIGINS=["http://localhost:8908","http://127.0.0.1:8908"]
